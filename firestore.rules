rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{col}/{id} {
      allow read, write: if request.auth != null && col in ['insumos', 'tecnicos'];
    }
    match /movimentacoes/{id} {
      allow read, update, delete: if request.auth != null;
      // quem liberou a retirada (campo "por") tem que ser o usuário logado: não dá para registrar em nome de outra pessoa
      allow create: if request.auth != null && request.resource.data.por == request.auth.token.email;
    }
  }
}
